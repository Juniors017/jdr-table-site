---
import { SITE, url } from '../site';
import '../styles/global.css';

interface Props {
  titre?: string;
  description?: string;
}
const { titre, description = SITE.description } = Astro.props;
const titreComplet = titre ? `${titre} · ${SITE.nom}` : `${SITE.nom} — la TV à plat comme plateau de jeu`;
const image = new URL(url('cartes/taverne.webp'), Astro.site);
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titreComplet}</title>
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={titreComplet} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#15120f" />
    <link rel="icon" type="image/svg+xml" href={url('favicon.svg')} />
    <link rel="preload" href={url('fonts/cinzel.woff2')} as="font" type="font/woff2" crossorigin />
    <style
      set:html={`
      @font-face { font-family: "Cinzel"; src: url(${url('fonts/cinzel.woff2')}) format("woff2"); font-weight: 400 900; font-display: swap; }
      @font-face { font-family: "Source Sans 3"; src: url(${url('fonts/source-sans-3.woff2')}) format("woff2"); font-weight: 200 900; font-display: swap; }
    `}
    />
  </head>
  <body>
    <header class="bandeau">
      <a class="logo" href={url('')}>
        <svg viewBox="0 0 32 32" aria-hidden="true"><path d="M16 2 28 9v14L16 30 4 23V9z" /><path d="M16 2v9m0 0 12 12M16 11 4 23m12-12 12-2M16 11 4 9m0 14h24" /></svg>
        {SITE.nom}
      </a>
      <nav aria-label="Navigation principale">
        <a href={url('fonctions/')}>Fonctions</a>
        <a href={url('#bestiaire')}>Bestiaire</a>
        <a href={url('#cartes')}>Cartes</a>
        <a href={url('catalogue/')}>Catalogue</a>
        <a class="bouton petit" href={url('#demarrer')}>Démarrer</a>
      </nav>
    </header>

    <main><slot /></main>

    <footer class="pied">
      <p>
        <strong>{SITE.nom}</strong> — appli et images créées par Juniors017.
        <a href={SITE.depotAppli}>Code de l'appli</a> · <a href={SITE.depotAssets}>Pack d'assets</a>
      </p>
      <p class="discret">© 2026 Juniors017. Images et cartes : tous droits réservés, reproduction et réutilisation interdites sans accord.</p>
      <p class="discret">
        Inspirations : Donjons &amp; Dragons et Ultima Online. Tous les visuels sont modélisés et rendus pour ce projet ;
        aucune image de ces jeux n'est reprise. Syrinscape est un service tiers, non affilié.
      </p>
    </footer>

    <script>
      // Charge les planches d'images seulement quand elles approchent de l'écran.
      const paresseux = new IntersectionObserver(
        (entrees) => {
          for (const e of entrees) {
            if (!e.isIntersecting) continue;
            const el = e.target as HTMLElement;
            el.style.backgroundImage = `url("${el.dataset.bg}")`;
            paresseux.unobserve(el);
          }
        },
        { rootMargin: '300px' },
      );
      document.querySelectorAll<HTMLElement>('[data-bg]').forEach((el) => paresseux.observe(el));
    </script>
  </body>
</html>
