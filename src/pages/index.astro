---
import Page from '../layouts/Page.astro';
import { url } from '../site';
import catalogue from '../data/catalogue.json';
import Clip from '../components/Clip.astro';
import Visionneuse from '../components/Visionneuse.astro';
import cartes from '../data/cartes.json';

type Element = { id: string; nom: string; genre: string; images?: number; boucle?: boolean; iw?: number; ih?: number };
const tous = [...catalogue.bestiaire, ...catalogue.objets].flatMap((t) => t.sections.flatMap((s) => s.items as Element[]));
const nom = (id: string) => tous.find((f) => f.id === id)?.nom ?? id;
const { chiffres: total } = catalogue;
const fr = (n: number) => n.toLocaleString('fr-FR');

// Cartes du haut de page : faites dans l'appli, dessinées par outils/preparer-cartes.mjs avec leurs pions et trajets
// (positions en cases, carte de 32 × 18). Elles défilent une à une ; la première est rendue dans la page.
const [premiere] = cartes;
const styleCarte = (id: string) => `background-image:url(${url(`cartes/${id}.webp`)})`;

const etapes = [
  { t: 'Pose la TV à plat', d: "N'importe quelle TV fait l'affaire. Une plaque de plexiglas par-dessus protège la dalle des figurines." },
  { t: 'Branche ton PC en HDMI', d: "La Vue Table s'ouvre toute seule en plein écran sur la TV. Ton écran, lui, reste l'écran du MJ." },
  { t: 'Calibre une fois', d: 'Mesure la barre jaune avec une règle : les cases font alors exactement la taille de tes socles (25,4 mm par défaut).' },
];

const fonctions = [
  { clip: 'brouillard', t: 'Brouillard de guerre', d: "Révèle ou cache la carte au pinceau. Les pions cachés et tes notes restent sur ton écran, jamais sur la TV." },
  { clip: 'trajets', t: 'PNJ autonomes', d: "Trajets tracés à la souris, errance dans une zone, trajet aléatoire : les PNJ contournent murs, portes fermées et lave tout seuls." },
  { clip: 'pions', t: 'Créatures en jeu', d: "Un pion caché apparaît dans la fumée, encaisse un coup, tombe. États, cercle de couleur, héros à terre." },
  { clip: 'carte-vivante', t: 'Carte vivante', d: 'Un clic ouvre une porte, un coffre ou le pont-levis, arme un piège, éteint une torche. Eau, lave et feux sont animés.' },
  { clip: 'declencheur', t: 'Déclencheurs et macros', d: "Une zone invisible lance une suite d'actions quand un pion y entre : piège, embuscade, mur qui se referme, scène suivante." },
  { clip: 'effets', t: 'Effets et météo', d: 'Boule de feu, éclair, glace, secousse, pluie, neige, nuit : un clic sur la carte, ou une touche là où est la souris.' },
  { clip: 'createur', t: 'Créateur de carte', d: 'Plus de 1 000 objets à peindre : sols raccordables, murs qui suivent la grille, mobilier, nature, navires. Pivoter, grouper, verrouiller, annuler.' },
  { clip: 'scenes', t: 'Scènes et quêtes', d: "Chaque scène garde carte, brouillard, pions et ambiance. Range-les par quête, puis enchaîne l'histoire d'une touche." },
  { clip: 'paroles', t: 'Paroles, annonces et sons', d: "Les PNJ parlent en bulles, une annonce s'affiche sur la TV. Sons intégrés hors ligne, ou ambiances Syrinscape." },
];

const vedettes = [
  'hero_fighter', 'hero_wizard_f', 'hero_rogue', 'hero_elf_archer', 'hero_dwarf_fighter', 'hero_paladin', 'hero_samurai', 'npc_innkeeper',
  'npc_queen', 'npc_blacksmith', 'soldier_red_officer', 'elf_lord', 'animal_horse', 'animal_lion', 'mob_goblin', 'mob_orc',
  'mob_owlbear', 'mob_minotaur', 'mob_death_knight', 'mob_genie', 'mob_treant', 'mob_phoenix', 'mob_dracolich', 'boss_lich',
];

const des = [
  { id: 'd4', faces: 4 }, { id: 'd6', faces: 6 }, { id: 'd8', faces: 8 }, { id: 'd10', faces: 10 },
  { id: 'd12', faces: 12 }, { id: 'd20', faces: 20 }, { id: 'd100', faces: 10 },
];

const animes = ['door_wood_anim', 'chest_royal_anim', 'fire_brazier_anim', 'waterfall_anim', 'magic_circle_anim', 'fairy_pond_anim', 'lava_anim', 'water_anim']
  .map((id) => tous.find((a) => a.id === id)!)
  .filter(Boolean)
  .map((a) => ({ ...a, images: a.images ?? 8, iw: a.iw ?? 1, ih: a.ih ?? 1 }));

const chiffres = [
  { n: fr(total.assets), t: 'images vues de dessus' },
  { n: fr(total.figurines), t: 'figurines animées' },
  { n: fr(total.animes), t: 'objets animés' },
  { n: fr(total.des), t: 'dés, du d4 au d100' },
  { n: fr(cartes.length), t: 'cartes prêtes à jouer' },
];

const lancement = [
  'Branche le PC sur la TV en HDMI (Windows : Win + P, puis « Étendre »).',
  'Double-clique sur « Lancer la table.bat ». La première fois, il installe l\'appli : compte une minute.',
  'Clique « Ouvrir la Vue Table » : elle s\'affiche en plein écran sur la TV.',
  'Calibre la TV, charge une carte prête à jouer, pose tes pions. La partie peut commencer.',
];
---

<Page>
  <section class="hero">
    <div class="hero-texte">
      <p class="sur-titre">Appli de jeu de rôle pour MJ</p>
      <h1>Ta TV à plat devient un plateau de jeu animé</h1>
      <p class="chapo">
        Pose tes figurines sur l'écran, pilote tout depuis ton PC : brouillard de guerre, créatures qui marchent,
        portes qui s'ouvrent, pièges qui se déclenchent, dés et ambiance sonore.
      </p>
      <div class="actions">
        <a class="bouton" href="#demarrer">Démarrer une partie</a>
        <a class="bouton creux" href="#fonctions">Voir les fonctions</a>
      </div>
    </div>

    <div class="tv-socle" aria-hidden="true">
      <div class="tv">
        <div class="plateau" id="plateau" style={styleCarte(premiere.id)} data-cartes={JSON.stringify(cartes)} data-base={url('')}>
          <div class="grille"></div>
          <div id="pions">
            {premiere.pions.map((p) => (
              <div
                class="fig pion"
                style={`width:${(p.taille / 32) * 100}%;left:${(p.pts[0][0] / 32) * 100}%;top:${(p.pts[0][1] / 18) * 100}%;background-image:url(${url(`marche-demo/${p.id}.webp`)})`}
              />
            ))}
          </div>
          <div class="voile"></div>
        </div>
      </div>
    </div>
    <p class="legende discret">
      <strong id="carte-titre">{premiere.titre}</strong>, une des {cartes.length} cartes faites dans l'appli.
      Les pions y font leur ronde en contournant murs, portes et mobilier.
    </p>
  </section>

  <section class="bloc" id="principe">
    <p class="sur-titre">Le principe</p>
    <h2>Deux écrans, une seule table</h2>
    <p class="chapo">La TV montre aux joueurs ce qu'ils ont le droit de voir. Ton écran montre tout le reste : pions cachés, trajets, zones de déclenchement.</p>
    <ol class="etapes">
      {etapes.map((e, i) => (
        <li>
          <span class="numero">{i + 1}</span>
          <h3>{e.t}</h3>
          <p>{e.d}</p>
        </li>
      ))}
    </ol>
  </section>

  <section class="bloc" id="ecran">
    <p class="sur-titre">L'écran du MJ</p>
    <h2>Tout se pilote depuis ton PC</h2>
    <p class="chapo">Deux modes : <strong>Jouer</strong> pour mener la partie, <strong>Préparer</strong> pour construire tes scènes. Voici l'appli telle qu'elle est.</p>
    <div class="captures">
      <figure>
        <a href={url('fonctions/#ecrans')}><img src={url('captures/jouer-pion.webp')} alt="Écran du MJ en mode Jouer : la taverne, ses pions et le panneau du pion sélectionné" width="1600" height="841" loading="lazy" /></a>
        <figcaption><strong>Jouer.</strong> Pions, brouillard, effets, dés : tout est à un clic.</figcaption>
      </figure>
      <figure>
        <a href={url('fonctions/#declencheurs')}><img src={url('captures/prep-declencheurs.webp')} alt="Écran du MJ en mode Préparer : liste des scènes, carte et panneau des déclencheurs" width="1600" height="841" loading="lazy" /></a>
        <figcaption><strong>Préparer.</strong> Scènes par quête, créateur de carte, déclencheurs.</figcaption>
      </figure>
    </div>
  </section>

  <section class="bloc" id="joueurs">
    <p class="sur-titre">Côté joueurs</p>
    <h2>Autour de la table, ou à distance</h2>
    <p class="chapo">Les joueurs ne voient que la Vue Table : jamais tes pions cachés, tes déclencheurs ni tes dés secrets.</p>
    <div class="cotes">
      <article>
        <Clip nom="tv-2d" alt="La Vue Table affichée sur la TV : brouillard, héros qui entrent, serveuse qui fait sa ronde" />
        <h3>Sur la TV, autour de la table</h3>
        <ul>
          <li>La carte en plein écran sous les figurines, à la taille exacte de leurs socles.</li>
          <li>Brouillard de guerre : seules les pièces découvertes apparaissent.</li>
          <li>Tout bouge : PNJ, portes, feux, effets, météo, dés, bulles de parole.</li>
          <li>Les annonces s'affichent dans les deux sens, pour ceux assis en face.</li>
          <li>Affichage 2D, ou 3D avec murs en volume et ombres.</li>
        </ul>
      </article>
      <article>
        <Clip nom="enligne-joueur" alt="La page d'une joueuse en ligne : elle déplace sa voleuse, écrit dans le récit et lance un d20" />
        <h3>En ligne, dans un navigateur</h3>
        <ul>
          <li>Rien à installer : un lien, un nom, le code de la partie.</li>
          <li>Le joueur voit la table en direct, comme sur la TV.</li>
          <li>Il déplace son personnage : clic, glisser ou clavier, Maj pour courir.</li>
          <li>Il le fait parler : la phrase s'affiche en bulle et dans le récit de la partie.</li>
          <li>Il lance ses dés, qui roulent sur la table de tous avec son nom.</li>
        </ul>
      </article>
    </div>
    <p class="suite">
      <a class="bouton creux" href={url('fonctions/#vue-table')}>La Vue Table en détail</a>
      <a class="bouton creux" href={url('fonctions/#joueurs-en-ligne')}>Tout ce que font les joueurs en ligne</a>
    </p>
  </section>

  <section class="bloc" id="fonctions">
    <p class="sur-titre">Les fonctions</p>
    <h2>Tout ce qu'il faut pour mener la partie</h2>
    <div class="cartouches">
      {fonctions.map((f) => (
        <article class="cartouche">
          <Clip nom={f.clip} alt={`Séquence tournée dans l'appli : ${f.t}`} />
          <h3>{f.t}</h3>
          <p>{f.d}</p>
        </article>
      ))}
    </div>
    <p class="chapo plus">
      Chaque séquence est tournée dans l'appli. Et aussi : dés animés, affichage 2D ou 3D de la table, gabarits de sorts,
      raccourcis clavier pour chaque action, partie en ligne, et trois quêtes d'exemple avec leur histoire pour le MJ.
    </p>
    <p class="suite"><a class="bouton" href={url('fonctions/')}>Découvrir toutes les fonctions</a></p>
  </section>

  <section class="bloc" id="bestiaire">
    <p class="sur-titre">Le bestiaire</p>
    <h2>{total.figurines} figurines qui marchent vraiment</h2>
    <p class="chapo">Héros, PNJ, soldats, animaux, monstres et attelages, rendus en 3D vus de dessus, dans les quatre directions. En voici quelques-uns.</p>
    <ul class="bestiaire">
      {vedettes.map((id) => (
        <li>
          <div class="fig" data-bg={url(`marche/mini/${id}.webp`)} role="img" aria-label={nom(id)}></div>
          <span>{nom(id)}</span>
        </li>
      ))}
    </ul>
    <p class="suite">
      <a class="bouton" href={url('bestiaire/')}>Voir tout le bestiaire</a>
      <a class="bouton creux" href={url('catalogue/')}>Parcourir le catalogue des objets</a>
    </p>
  </section>

  <section class="bloc" id="cartes">
    <p class="sur-titre">Les cartes</p>
    <h2>{cartes.length} cartes prêtes à jouer</h2>
    <p class="chapo">Un clic les charge, 32 × 18 cases, pile à la taille de la TV. Tu peux ensuite tout modifier dans le créateur de carte.</p>
    <div class="cartes">
      {cartes.map((c) => (
        <figure>
          <button type="button" class="zoom" data-zoom={url(`cartes/${c.id}.webp`)} data-genre="piece" data-nom={c.titre} data-info="Carte de 32 × 18 cases, faite dans l'appli">
            <img src={url(`cartes/mini/${c.id}.webp`)} alt={`Carte vue de dessus : ${c.titre}`} width="960" height="540" loading="lazy" />
          </button>
          <figcaption>{c.titre}</figcaption>
        </figure>
      ))}
    </div>
  </section>

  <section class="bloc deux" id="des">
    <div>
      <p class="sur-titre">Les dés</p>
      <h2>Lance les dés au milieu de la table</h2>
      <p class="chapo">Du d4 au d100, le dé roule au centre de la TV puis affiche son résultat. En lancer secret, il n'apparaît que sur l'écran du MJ.</p>
      <div class="choix-des" role="group" aria-label="Choisir un dé à lancer">
        {des.map((d) => (
          <button type="button" class="bouton creux petit" data-de={d.id} data-faces={d.faces}>{d.id}</button>
        ))}
      </div>
    </div>
    <div class="piste">
      <div class="de" id="de" style={`--n:20;background-image:url(${url('des/d20_resultats.webp')});background-position-x:100%`}></div>
      <p id="de-texte" aria-live="polite">Essaie : clique sur un dé.</p>
    </div>
  </section>

  <section class="bloc" id="pack">
    <p class="sur-titre">Le pack d'images</p>
    <h2>Un donjon entier, modélisé pour la table</h2>
    <p class="chapo">Chaque image est rendue en 3D sous Blender, vue de dessus, avec son ombre : 200 px par case, la lumière vient toujours du même côté, tout se raccorde.</p>
    <dl class="chiffres">
      {chiffres.map((c) => (
        <div><dt>{c.n}</dt><dd>{c.t}</dd></div>
      ))}
    </dl>
    <ul class="animes">
      {animes.map((a) => (
        <li>
          <div
            class:list={['bande', { 'aller-retour': !a.boucle }]}
            data-bg={url(`anim/${a.id}.webp`)}
            style={`--n:${a.images};--duree:${a.boucle ? a.images * 0.11 : 1.4}s;aspect-ratio:${a.iw}/${a.ih}`}
            role="img"
            aria-label={a.nom}
          ></div>
          <span>{a.nom}</span>
        </li>
      ))}
    </ul>
  </section>

  <section class="bloc" id="demarrer">
    <p class="sur-titre">Démarrer</p>
    <h2>Prêt en quatre étapes</h2>
    <div class="deux">
      <ol class="lancement">
        {lancement.map((l) => <li>{l}</li>)}
      </ol>
      <aside class="conseils">
        <h3>Avant de poser la TV</h3>
        <ul>
          <li>Protège la dalle avec une plaque de plexiglas ou de verre trempé.</li>
          <li>Vérifie que les aérations ne sont pas bouchées une fois la TV à plat.</li>
          <li>Coupe la mise en veille de la TV et du PC le temps de la partie.</li>
        </ul>
        <p class="discret">Il te faut un PC sous Windows, un câble HDMI et Node.js pour la première installation.</p>
      </aside>
    </div>
    <div class="actions">
      <a class="bouton" href={url('fonctions/')}>Découvrir toutes les fonctions</a>
      <a class="bouton creux" href={url('catalogue/')}>Parcourir le catalogue</a>
    </div>
  </section>
  <Visionneuse />
</Page>

<script>
  // --- Carte du haut de page : les pions font leur ronde, puis le brouillard passe et la carte suivante arrive. ---
  type Pion = { id: string; taille: number; v: number; pts: [number, number][] };
  type Carte = { id: string; titre: string; pions: Pion[] };
  const calme = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const plateau = document.getElementById('plateau')!;
  const boitePions = document.getElementById('pions')!;
  const voile = plateau.querySelector<HTMLElement>('.voile')!;
  const titre = document.getElementById('carte-titre')!;
  const cartes: Carte[] = JSON.parse(plateau.dataset.cartes!);
  const base = plateau.dataset.base!;
  const DUREE = 14; // secondes passées sur chaque carte (seulement quand elle est à l'écran)
  const FONDU = 900; // ms : durée du brouillard (même valeur que la transition CSS de .voile)

  let numero = 0;
  let pions: { el: HTMLElement; pts: [number, number][]; v: number; i: number; sens: number; x: number; y: number; pause: number; ligne: number }[] = [];
  const placer = (p: (typeof pions)[number]) => {
    p.el.style.left = `${(p.x / 32) * 100}%`;
    p.el.style.top = `${(p.y / 18) * 100}%`;
  };
  function poserPions(c: Carte) {
    const els = c.pions.map((p) => {
      const el = document.createElement('div');
      el.className = 'fig pion';
      el.style.width = `${(p.taille / 32) * 100}%`;
      el.style.backgroundImage = `url(${base}marche-demo/${p.id}.webp)`;
      return el;
    });
    boitePions.replaceChildren(...els);
    suivrePions(c);
  }
  function suivrePions(c: Carte) {
    const els = [...boitePions.children] as HTMLElement[];
    pions = c.pions.map((p, k) => ({ el: els[k], pts: p.pts, v: p.v, i: 1, sens: 1, x: p.pts[0][0], y: p.pts[0][1], pause: Math.random() * 1.5, ligne: 0 }));
    pions.forEach(placer);
  }
  suivrePions(cartes[0]);

  // La carte suivante et ses pions sont chargés pendant qu'on regarde celle-ci.
  const prete = new Map<number, Promise<void>>();
  const charger = (n: number) => {
    if (!prete.has(n)) {
      const c = cartes[n];
      const urls = [`${base}cartes/${c.id}.webp`, ...c.pions.map((p) => `${base}marche-demo/${p.id}.webp`)];
      prete.set(n, Promise.all(urls.map((u) => new Promise<void>((ok) => { const im = new Image(); im.onload = im.onerror = () => ok(); im.src = u; }))).then(() => {}));
    }
    return prete.get(n)!;
  };
  let change = false;
  async function carteSuivante() {
    change = true;
    const n = (numero + 1) % cartes.length;
    await charger(n);
    voile.classList.add('couvre');
    await new Promise((ok) => setTimeout(ok, FONDU));
    numero = n;
    plateau.style.backgroundImage = `url(${base}cartes/${cartes[n].id}.webp)`;
    titre.textContent = cartes[n].titre;
    poserPions(cartes[n]);
    voile.classList.remove('couvre');
    charger((n + 1) % cartes.length);
    change = false;
  }

  let visible = true;
  new IntersectionObserver(([e]) => (visible = e.isIntersecting)).observe(plateau);
  let surCarte = 0;
  let avant = performance.now();
  function pas(maintenant: number) {
    const dt = Math.min(0.05, (maintenant - avant) / 1000);
    avant = maintenant;
    if (visible && !change && cartes.length > 1) {
      surCarte += dt;
      if (surCarte > DUREE - 4) charger((numero + 1) % cartes.length);
      if (surCarte > DUREE) {
        surCarte = 0;
        carteSuivante();
      }
    }
    for (const p of pions) {
      if (p.pause > 0) {
        p.pause -= dt;
        p.el.style.setProperty('--ligne', String(p.ligne % 4));
        continue;
      }
      const [cx, cy] = p.pts[p.i];
      const dx = cx - p.x;
      const dy = cy - p.y;
      const d = Math.hypot(dx, dy);
      const avance = p.v * dt;
      if (d <= avance) {
        p.x = cx;
        p.y = cy;
        if (p.i + p.sens < 0 || p.i + p.sens >= p.pts.length) {
          p.sens = -p.sens;
          p.pause = 1.5 + Math.random() * 2;
        }
        p.i += p.sens;
      } else {
        p.x += (dx / d) * avance;
        p.y += (dy / d) * avance;
        // Lignes de marche de la planche : 4 = bas, 5 = gauche, 6 = droite, 7 = haut.
        p.ligne = Math.abs(dx) > Math.abs(dy) ? (dx < 0 ? 5 : 6) : dy > 0 ? 4 : 7;
        p.el.style.setProperty('--ligne', String(p.ligne));
      }
      placer(p);
    }
    requestAnimationFrame(pas);
  }
  if (!calme) requestAnimationFrame(pas);

  // --- Dés : la bande « lancer » tourne 0,6 s, puis on affiche l'image du résultat tiré. ---
  const de = document.getElementById('de')!;
  const texte = document.getElementById('de-texte')!;
  const dossier = de.style.backgroundImage.replace(/d20_resultats\.webp.*$/, '').replace(/^url\(["']?/, '');
  let minuterie = 0;
  document.querySelectorAll<HTMLButtonElement>('[data-de]').forEach((b) =>
    b.addEventListener('click', () => {
      const id = b.dataset.de!;
      const faces = Number(b.dataset.faces);
      const tire = Math.floor(Math.random() * faces);
      clearTimeout(minuterie);
      de.className = 'de';
      de.style.cssText = `--n:12;--duree:.6s;background-image:url("${dossier}${id}_lancer.webp")`;
      void de.offsetWidth; // relance l'animation
      if (!calme) de.classList.add('bande', 'roule');
      texte.textContent = `Le ${id} roule…`;
      minuterie = window.setTimeout(
        () => {
          de.className = 'de pose';
          de.style.cssText = `--n:${faces};background-image:url("${dossier}${id}_resultats.webp");background-position-x:${(tire / (faces - 1)) * 100}%`;
          texte.textContent = id === 'd100' ? 'Le d100 donne les dizaines : lance un d10 pour les unités.' : `${id} : ${tire + 1}`;
        },
        calme ? 0 : 900,
      );
    }),
  );
</script>

<style>
  .hero { max-width: var(--large); margin: 0 auto; padding: clamp(32px, 5vw, 56px) 20px 40px; text-align: center; }
  .hero-texte { display: grid; justify-items: center; }
  .hero .chapo { margin-inline: auto; }
  .actions { display: flex; flex-wrap: wrap; gap: 12px; justify-content: center; margin-top: 30px; }
  #demarrer .actions { justify-content: flex-start; }

  /* La TV posée à plat, vue en légère plongée. */
  .tv-socle { perspective: 1600px; margin: clamp(4px, 1vw, 12px) auto 0; max-width: 1040px; }
