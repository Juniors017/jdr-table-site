---
// Séquence animée tournée dans l'appli (WebP animé). Si le visiteur a demandé moins d'animations, on montre une image fixe.
import { url } from '../site';

// Taille de chaque séquence (largeur × hauteur en pixels), pour réserver la place avant le chargement.
const TAILLES: Record<string, [number, number]> = {
  createur: [960, 505],
  scenes: [960, 505],
  'enligne-joueur': [960, 570],
  pions: [720, 411],
  des: [720, 411],
  'carte-vivante': [720, 411],
};

interface Props {
  nom: string;
  alt: string;
}
const { nom, alt } = Astro.props;
const [w, h] = TAILLES[nom] ?? [720, 405];
---

<picture>
  <source media="(prefers-reduced-motion: reduce)" srcset={url(`clips/${nom}-fixe.webp`)} />
  <img src={url(`clips/${nom}.webp`)} alt={alt} width={w} height={h} loading="lazy" decoding="async" />
</picture>

<style>
  img { width: 100%; height: auto; background: #0b0a09; }
</style>
